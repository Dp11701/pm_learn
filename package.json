{
  "name": "hoc-pm-a-z",
  "private": true,
  "version": "0.0.0",
  "description": "Web app cá nhân tự học Project Management theo roadmap.sh (project-management-crez9)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "predev": "tsx scripts/kiem-moi-truong.ts",
    "dev": "concurrently -k -n web,api -c blue,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:mau": "tsx scripts/dev-mau.ts",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "test": "npm run test:tz && npm run test:go-cung",
    "test:unit": "vitest run",
    "test:tz": "TZ=Asia/Ho_Chi_Minh vitest run && TZ=America/Los_Angeles vitest run tests/domain",
    "test:go-cung": "tsx scripts/kiem-go-cung.ts",
    "test:bundle": "tsx scripts/kiem-bundle.ts",
    "test:tuong-phan": "tsx scripts/kiem-tuong-phan.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:tuong-phan && npm run test:bundle",
    "frame": "tsx scripts/xem-frame.ts"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tanstack/react-query": "5.104.5",
    "better-sqlite3": "13.0.3",
    "express": "5.3.0",
    "lucide-react": "1.61.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router": "7.18.4",
    "remark-gfm": "4.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
